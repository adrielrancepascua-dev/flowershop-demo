# App mode — multi-branch back office demo
VITE_APP_MODE=flower_demo

# Optional white-label branding
# VITE_BRAND_NAME=Plaza Retail
# VITE_BRAND_TAGLINE=Multi-branch inventory, sales, and staff operations
# VITE_BRAND_LOGO_SRC=/demo-logo.svg
# VITE_CONTACT_PHONE=(555) 010-0200
# VITE_HUB_BRANCH_ID=branch-north
# VITE_STAFF_EMAIL_DOMAIN=demo.plazaretail.app

# Production (optional — connect your own Supabase project)
# VITE_FLOWER_STORAGE_MODE=supabase
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage mode overrides (default: auto)
# VITE_FLOWER_STORAGE_MODE=auto|local|supabase
